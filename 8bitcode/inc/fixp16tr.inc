;
; signed 16-bit fixed point trigonometry
;
; Scale 8 (sign 7-bit, 8-bit)
;
;

;
; FXP16_C = cos(FXP16_A)
;
FXP16_COS:
	mov RB, FXP16_A
	mov RA, FXP16_A+1
	
	; cos(x) = sin(x+PI/2)
	CLC
	ADD RB, FXP16_PIover2
	ADD RA, FXP16_PIover2+1
	JMP _FXP16_SIN_AB

;
; FXP16_C = sin(FXP16_A)
;
FXP16_SIN:
	mov RB, FXP16_A
	mov RA, FXP16_A+1
	
; FXP16_C = sin(RB/RA)
_FXP16_SIN_AB:

	; argument >= 0?
	OR RA, #0
	JNN _FXP16_SIN_AB_POS ; yes!
	
	; sin(x) == -sin(-x)
	XOR RB, #0xFF
	XOR RA, #0xFF
	INC RB
	ICC RA
	JSR _FXP16_SIN_AB_POS ; calculate sine
_FXP16_INVERSE_BA:
	XOR RA, #0xFF
	XOR RB, #0xFF
	INC RA
	ICC RB
	mov FXP16_C, RA
	mov FXP16_C+1, RB
	RTS

;
; RA/RB = sin(RB/RA)
;   having RB/RA >= 0
;
_FXP16_SIN_AB_POS:
	STC
	SUB RB, FXP16_8PI
	SUB RA, FXP16_8PI+1
	JCS _FXP16_SIN_AB_POS
	ADD RB, FXP16_8PI
	ADD RA, FXP16_8PI+1

;
; RA/RB = sin(RB/RA)
;   having RB/RA in [0;8*PI]
;
_FXP16_SIN_AB_8PI:
	STC
	SUB RB, FXP16_2PI
	SUB RA, FXP16_2PI+1
	JCS _FXP16_SIN_AB_8PI
	ADD RB, FXP16_2PI
	ADD RA, FXP16_2PI+1
	
;
; RA/RB = sin(RB/RA)
;   having RB/RA in [0;2*PI]
;
_FXP16_SIN_AB_2PI:
	STC
	CMP RB, FXP16_PI
	CMP RA, FXP16_PI+1
	JNC _FXP16_SIN_AB_PI
	
	; sin(x) = -sin(x+pi)
	SUB RB, FXP16_PI
	SUB RA, FXP16_PI+1
	JSR _FXP16_SIN_AB_PI
	JMP _FXP16_INVERSE_BA
	
;
; RA/RB = sin(RB/RA)
;   having RB/RA in [0;PI]
;
_FXP16_SIN_AB_PI:
	STC
	CMP RB, FXP16_PIover2
	CMP RA, FXP16_PIover2+1
	JNC _FXP16_NORM_SIN
	
	; sin(x) = sin(pi-x)
	SUB RB, FXP16_PI
	SUB RA, FXP16_PI+1
	XOR RB, #0xFF
	XOR RA, #0xFF
	INC RB
	ICC RA
	
;
; RA/RB = sin(RB/RA)
;   having RB/RA in [0;PI/2]
;
_FXP16_NORM_SIN:
	
	; A >= 1?
	OR  RA, #0
	JNZ .one_or_greater
	
	; get value from lower table
	mov RA, FXP16_SIN_TAB,RB
	mov RB, #0
	JMP .set_result
	
.one_or_greater:
	mov RA, FXP16_SIN_TAB_HI,RB
	mov RB, #0
	OR  RA, RB
	JNZ .set_result
	
	; result = 1
	INC RB

.set_result:
	mov FXP16_C, RA
	mov FXP16_C+1, RB
	RTS


	#d RELOC_ESC
	ld16 FXP16_TAB_END-FXP16_SIN_TAB+1

